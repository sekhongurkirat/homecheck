# PostgreSQL / PostGIS connection string
DATABASE_URL=postgresql://homecheck:homecheck_secret@localhost:5432/homecheck

# Mapbox public token — used by the frontend (set NEXT_PUBLIC_MAPBOX_TOKEN in frontend/.env.local too)
MAPBOX_TOKEN=pk.your_mapbox_token_here

# GreatSchools API key (optional — school ratings)
GREATSCHOOLS_API_KEY=your_greatschools_api_key_here
