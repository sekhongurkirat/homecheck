# Backend URL reachable from the browser (used by lib/api.ts)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend URL used server-side by Next.js rewrites (next.config.js)
BACKEND_URL=http://localhost:8000

# Mapbox public token — get one at https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

# Google Maps API key (for Street View embed, optional)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_key_here
